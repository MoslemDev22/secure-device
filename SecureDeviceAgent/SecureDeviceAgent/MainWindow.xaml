<Window x:Class="SecureDeviceAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secure Device Agent"
        Height="720"
        Width="1050"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Window.Resources>

        <!-- Colors -->

        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="DarkBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="#EA580C"/>


        <!-- Card -->

        <Style x:Key="InfoCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource CardBrush}"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="20"/>

            <Setter Property="Margin"
                    Value="6"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


        <!-- Small Label -->

        <Style x:Key="InfoLabelStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>

        </Style>


        <!-- Value -->

        <Style x:Key="InfoValueStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource DarkBrush}"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>


        <!-- Metric Value -->

        <Style x:Key="MetricValueStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource DarkBrush}"/>

            <Setter Property="FontSize"
                    Value="30"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="105"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ================= HEADER ================= -->

        <Border Grid.Row="0"
                Background="{StaticResource DarkBrush}">

            <Grid Margin="32,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock
                        Text="SECURE DEVICE AGENT"
                        Foreground="White"
                        FontSize="23"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="Windows Device Monitoring Agent"
                        Foreground="#94A3B8"
                        FontSize="13"
                        Margin="0,5,0,0"/>

                </StackPanel>


                <!-- Agent Status -->

                <Border Grid.Column="1"
        Background="#163B2A"
        BorderBrush="#2E7D55"
        BorderThickness="1"
        CornerRadius="20"
        Padding="14,7"
        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionStatusIndicator"
                 Width="9"
                 Height="9"
                 Fill="#22C55E"
                 Margin="0,0,8,0"/>

                        <TextBlock x:Name="ConnectionStatusText"
                   Text="Initializing"
                   Foreground="#86EFAC"
                   FontSize="13"
                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Border>


        <!-- ================= CONTENT ================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30">


                <!-- Title -->

                <TextBlock
                    Text="System Overview"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="{StaticResource DarkBrush}"/>

                <TextBlock
                    Text="Live information collected from this Windows device"
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Margin="0,5,0,18"/>


                <!-- ================= DEVICE INFO ================= -->

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0"
                            Style="{StaticResource InfoCardStyle}">

                        <StackPanel>

                            <TextBlock
                                Text="COMPUTER"
                                Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock
                                x:Name="ComputerNameText"
                                Style="{StaticResource InfoValueStyle}"/>

                        </StackPanel>

                    </Border>


                    <Border Grid.Column="1"
                            Style="{StaticResource InfoCardStyle}">

                        <StackPanel>

                            <TextBlock
                                Text="OPERATING SYSTEM"
                                Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock
                                x:Name="OperatingSystemText"
                                Style="{StaticResource InfoValueStyle}"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <Border Grid.Column="2"
                            Style="{StaticResource InfoCardStyle}">

                        <StackPanel>

                            <TextBlock
                                Text="ARCHITECTURE"
                                Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock
                                x:Name="ArchitectureText"
                                Style="{StaticResource InfoValueStyle}"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================= LIVE METRICS ================= -->

                <TextBlock
                    Text="Live Performance"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="{StaticResource DarkBrush}"
                    Margin="0,24,0,10"/>


                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- CPU -->

                    <Border Grid.Column="0"
                            Style="{StaticResource InfoCardStyle}">

                        <StackPanel>

                            <TextBlock
                                Text="CPU USAGE"
                                Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock
                                x:Name="CpuUsageText"
                                Text="0.00%"
                                Style="{StaticResource MetricValueStyle}"/>

                            <ProgressBar
                                x:Name="CpuProgressBar"
                                Minimum="0"
                                Maximum="100"
                                Height="7"
                                Margin="0,14,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- RAM -->

                    <Border Grid.Column="1"
                            Style="{StaticResource InfoCardStyle}">

                        <StackPanel>

                            <TextBlock
                                Text="RAM USAGE"
                                Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock
                                x:Name="RamUsageText"
                                Text="0.00%"
                                Style="{StaticResource MetricValueStyle}"/>

                            <ProgressBar
                                x:Name="RamProgressBar"
                                Minimum="0"
                                Maximum="100"
                                Height="7"
                                Margin="0,14,0,0"/>

                            <TextBlock
                                x:Name="RamDetailsText"
                                Text="0 MB / 0 MB"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                FontSize="12"
                                Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- DISK -->

                    <Border Grid.Column="2"
                            Style="{StaticResource InfoCardStyle}">

                        <StackPanel>

                            <TextBlock
                                Text="DISK USAGE"
                                Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock
                                x:Name="DiskUsageText"
                                Text="0.00%"
                                Style="{StaticResource MetricValueStyle}"/>

                            <ProgressBar
                                x:Name="DiskProgressBar"
                                Minimum="0"
                                Maximum="100"
                                Height="7"
                                Margin="0,14,0,0"/>

                            <TextBlock
                                x:Name="DiskDetailsText"
                                Text="0 GB / 0 GB"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                FontSize="12"
                                Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================= HARDWARE ================= -->

                <TextBlock
                    Text="Hardware Information"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="{StaticResource DarkBrush}"
                    Margin="0,24,0,10"/>


                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- CPU -->

                    <Border Grid.Column="0"
                            Style="{StaticResource InfoCardStyle}">

                        <StackPanel>

                            <TextBlock
                                Text="PROCESSOR"
                                Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock
                                x:Name="CpuText"
                                Style="{StaticResource InfoValueStyle}"
                                TextWrapping="Wrap"
                                Margin="0,0,0,14"/>

                            <TextBlock
                                Text="CPU CORES"
                                Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock
                                x:Name="CpuCoresText"
                                Style="{StaticResource InfoValueStyle}"/>

                        </StackPanel>

                    </Border>


                    <!-- RAM -->

                    <Border Grid.Column="1"
                            Style="{StaticResource InfoCardStyle}">

                        <StackPanel>

                            <TextBlock
                                Text="TOTAL MEMORY"
                                Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock
                                x:Name="RamText"
                                Style="{StaticResource InfoValueStyle}"/>

                        </StackPanel>

                    </Border>


                    <!-- DISK -->

                    <Border Grid.Column="2"
                            Style="{StaticResource InfoCardStyle}">

                        <StackPanel>

                            <TextBlock
                                Text="TOTAL STORAGE"
                                Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock
                                x:Name="DiskTotalText"
                                Style="{StaticResource InfoValueStyle}"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================= STORAGE ================= -->

                <Border
                    Style="{StaticResource InfoCardStyle}"
                    Padding="22"
                    Margin="6,18,6,6">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="USED SPACE"
                                Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock
                                x:Name="DiskUsedText"
                                Style="{StaticResource InfoValueStyle}"/>

                        </StackPanel>


                        <StackPanel Grid.Column="1">

                            <TextBlock
                                Text="FREE SPACE"
                                Style="{StaticResource InfoLabelStyle}"/>

                            <TextBlock
                                x:Name="DiskFreeText"
                                Style="{StaticResource InfoValueStyle}"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- Footer -->

                <TextBlock
                    Text="Secure Device Management Platform • Windows Agent"
                    HorizontalAlignment="Center"
                    Foreground="#94A3B8"
                    FontSize="12"
                    Margin="0,18,0,8"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>